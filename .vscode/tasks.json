{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile", // предполагается, что в package.json есть "compile": "tsc -p ."
      "problemMatcher": ["$tsc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "shell": {
          "executable": "/bin/bash",
          "args": ["-i", "-c"]
        }
      }
    }
  ]
}
